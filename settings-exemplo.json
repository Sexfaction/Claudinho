      { "hooks": [ { "type": "command", "command": "curl -s --connect-timeout 0.2 -m 1 --data-binary @- http://127.0.0.1:47821/evento || exit 0", "async": true } ] }
    ],
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "curl -s --connect-timeout 0.2 -m 1 --data-binary @- http://127.0.0.1:47821/evento || exit 0", "async": true } ] }
    ],
    "PostCompact": [
      { "hooks": [ { "type": "command", "command": "curl -s --connect-timeout 0.2 -m 1 --data-binary @- http://127.0.0.1:47821/evento || exit 0", "async": true } ] }
